{
  "userAgent": "job_seeker_ro_spider",
  "requestTimeoutMs": 10000,
  "pageDelayMs": 1000,
  "staleJobDeletion": false,
  "manageCompany": true,
  "defaultLocation": ["Cluj-Napoca"],
  "defaultWorkmode": "on-site",
  "ownJobUrlPrefix": "https://cemacon.ro/cariere/",
  "sources": {
    "sitemap": "",
    "listing": "https://cemacon.ro/cariere/",
    "jobArchive": "https://cemacon.ro/cariere/"
  },
  "selectors": {
    "jobArticle": ["article.cemacon-cariere-card", "[class*='job']", ".vacancy, .position, .listing-item"],
    "jobTitle": [".cemacon-cariere-card__title a", "h1, h2, h3, h4", "[itemprop='title'], [aria-label]", "a"],
    "jobMeta": [".cemacon-cariere-card__excerpt", "p, .meta, [class*='deadline']"]
  }
}
